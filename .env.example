DEVOS_RUNTIME_PORT=3180
# Generate a long random value and provide the same value to the local DevOS Web instance.
DEVOS_RUNTIME_TOKEN=replace-with-a-long-random-token
# Comma-separated browser origins allowed to call the Runtime.
DEVOS_RUNTIME_ORIGINS=http://localhost:3000
# Comma-separated local folders that DevOS Runtime may inspect or execute jobs in.
# Defaults to the current user's home directory when omitted.
DEVOS_RUNTIME_WORKSPACE_ROOTS=C:\\path\\to\\your\\projects
# Docker provisioning is disabled until explicitly enabled.
DEVOS_RUNTIME_DOCKER_ENABLED=false
